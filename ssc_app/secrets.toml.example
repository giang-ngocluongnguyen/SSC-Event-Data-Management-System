# Copy this file to `.streamlit/secrets.toml` for local development.
# Never commit the real secrets.toml file to GitHub.

[auth.users.admin-1]
display_name = "Admin 1"
role = "admin"
password = "CHANGE-TO-A-STRONG-UNIQUE-PASSWORD"

[auth.users.admin-2]
display_name = "Admin 2"
role = "admin"
password = "CHANGE-TO-A-DIFFERENT-STRONG-PASSWORD"

[auth.users.volunteer]
display_name = "Volunteer"
role = "volunteer"
password = "CHANGE-TO-A-THIRD-STRONG-PASSWORD"
